{
  "name": "rn-boilerplate",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "packageManager": "bun@1.3.14",
  "dependencies": {
    "@expo/ui": "~57.0.21",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-glass-effect": "~57.0.4",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.25",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "pull": "bunx eas-cli env:pull --environment development --path .env.local",
    "pull:preview": "bunx eas-cli env:pull --environment preview --path .env.local",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --dev-client --localhost",
    "android": "expo run:android --device --no-bundler",
    "ios": "expo run:ios --device --no-bundler",
    "web": "expo start --web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "staticchecks": "bun run lint && bun run typecheck",
    "preview": "bunx eas-cli build --platform all --profile preview --auto-submit",
    "preview:android": "bunx eas-cli build --platform android --profile preview",
    "preview:ios": "bunx eas-cli build --platform ios --profile preview --auto-submit",
    "prod": "bunx eas-cli build --platform all --profile production --auto-submit",
    "prod:android": "bunx eas-cli build --platform android --profile production",
    "prod:ios": "bunx eas-cli build --platform ios --profile production --auto-submit",
    "update": "bunx eas-cli update --channel production --environment production"
  },
  "private": true
}
